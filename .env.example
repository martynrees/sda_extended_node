# Copy this file to .env and fill in the values for this customer/lab.
#
# .env is gitignored — safe to keep real hostnames/URLs in your local copy.
# NEVER put a password in here (or in any file): passwords are always
# prompted interactively via getpass and are never read from disk.
#
# CLI flags always override these values, so this file only removes the
# NEED to pass constants on every command line — it doesn't remove the
# ability to override one on a one-off run, e.g.:
#   python onboard_extended_nodes.py monitor --csv extended_nodes.csv --base-url https://other-controller

# --- Catalyst Center ---
CATC_BASE_URL=https://10.1.1.1
CATC_USERNAME=admin
# Must match Settings > About on your controller.
CATC_CC_VERSION=2.3.7.9
# Self-signed lab controllers only. true/false (also accepts yes/no/1/0).
CATC_NO_VERIFY_SSL=false

# --- ISE (only used with `monitor --ise`) ---
ISE_BASE_URL=https://10.1.1.2:9060
# Optional — omit to reuse the Catalyst Center username/password above
# (no extra password prompt). Set this only to use a different ISE account,
# which will then prompt for its own password.
#ISE_USERNAME=
# Full ERS NDG path, e.g. "Device Type#All Device Types#SDA-Extended-Node".
# Confirm the real target NDG in the ISE GUI before setting this — see README.
ISE_NDG=Device Type#All Device Types#SDA-Extended-Node
# Self-signed lab ISE only.
ISE_NO_VERIFY_SSL=false

# --- SSH hostname push (only used with `monitor --rename-hostname`) ---
# Netmiko device_type — override for extended-node hardware that isn't classic IOS.
DEVICE_TYPE=cisco_ios
DEVICE_PORT=22
